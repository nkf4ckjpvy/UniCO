  "bidirectional": false,
  "image_input_channels": 24,
  "pretrained_image_encoder": true,
  "image_feature_dim": 32,
  "fusion_bottleneck_dim": 32,
  "final_dim": 128,
  "lr_milestones": [30, 40],
  "threshold_selection": "train_score_95th_percentile",
  "threshold_percentile": 0.95,
  "evaluation_adjustment": "window_level_segments",
  "threshold_step": 0.001
